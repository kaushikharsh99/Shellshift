datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String           @id @default(uuid())
  oidcSub     String
  oidcIssuer  String
  email       String?
  name        String
  role        String           @default("USER") // USER, ADMIN
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rosterEntries RosterMember[]
  memberships TeamMembership[]
  commandLogs CommandLog[]
  auditLogs   AuditLog[]
  registrations GameRegistration[]
  runs        Run[]
  createdEvents Event[]          @relation("EventCreator")

  @@unique([oidcIssuer, oidcSub])
  @@index([oidcIssuer, oidcSub])
}

model Team {
  id          String           @id @default(uuid())
  name        String           @unique
  inviteCode  String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships TeamMembership[]
  runs        Run[]
  wonEvents   Event[]          @relation("EventWinner")
}

model TeamMembership {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER") // LEADER, MEMBER
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Event {
  id              String    @id @default(uuid())
  slug            String?   @unique
  name            String
  description     String?
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, PAUSED, ENDED, ARCHIVED
  visibility      String    @default("PUBLIC") // PUBLIC, UNLISTED
  mode            String    @default("POINTS_TOURNAMENT") // FIRST_FINISH, POINTS_TOURNAMENT
  scoringConfig   String?   // JSON string
  leaderboardVisibility String @default("LIVE") // LIVE, AFTER_END, HIDDEN
  registrationOpensAt DateTime?
  registrationClosesAt DateTime?
  timezone        String    @default("UTC")
  createdById     String?
  winnerTeamId    String?
  winnerClaimedAt DateTime?
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  winnerTeam Team? @relation("EventWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rosterTeams CompetitionTeam[]
  rosterMembers RosterMember[]
  challenges EventChallenge[]
  registrations GameRegistration[]
  runs Run[]

  @@index([status, startTime])
}

model EventChallenge {
  id               String @id @default(uuid())
  eventId          String
  challengeId      String
  order            Int
  pointsOverride   Int?
  timeLimitSeconds Int?
  unlocksAt        DateTime?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([eventId, challengeId])
  @@index([eventId, order])
}

model GameRegistration {
  id           String   @id @default(uuid())
  eventId      String
  userId       String
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model Challenge {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  description       String
  difficulty        String   @default("MEDIUM") // EASY, MEDIUM, HARD
  order             Int      @default(1)
  timeLimitSeconds  Int      @default(1200) // 20 minutes default
  scoringConfig     String?  // JSON string
  commandMappings   String   // JSON string
  clues             String   // JSON string
  initialFilesystem String   // JSON string
  objectiveConfig   String   // JSON string
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  runs              Run[]
  hints             Hint[]
  events            EventChallenge[]

  @@index([order])
}

model Run {
  id                   String                @id @default(uuid())
  rosterTeamId         String?
  rosterTeam           CompetitionTeam? @relation(fields: [rosterTeamId], references: [id], onDelete: SetNull)
  teamId               String?
  legacyTeamId         String?
  legacyIndividualEligible Boolean           @default(false)
  userId               String?
  eventId              String?
  challengeId          String
  status               String                @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, EXPIRED, FAILED, ABANDONED
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  deadlineAt           DateTime?
  durationMs           Int?
  filesystemState      String                // JSON string
  currentWorkingDir    String                @default("/workspace")
  commandCount         Int                   @default(0)
  scoringSnapshot      String?               // JSON string
  objectivePoints      Int                   @default(0)
  completionBonus      Int                   @default(0)
  speedBonus           Float                 @default(0)
  hintPenalty          Int                   @default(0)
  baseScore            Float                 @default(0)
  difficultyMultiplier Float                 @default(1.0)
  finalScore           Float                 @default(0)
  scoringBreakdown     String?               // JSON string
  isRanked             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  team                 Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  challenge            Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  commandLogs          CommandLog[]
  hintUsages           HintUsage[]
  objectiveCompletions ObjectiveCompletion[]

  @@index([teamId, challengeId])
  @@index([eventId, userId, challengeId])
  @@index([status, durationMs])
  @@index([finalScore])
}

model ObjectiveCompletion {
  id            String   @id @default(uuid())
  runId         String
  objectiveId   String
  ruleIndex     Int      @default(0)
  pointsAwarded Int      @default(0)
  completedAt   DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, objectiveId])
  @@index([runId])
}

model CommandLog {
  id              String   @id @default(uuid())
  runId           String
  userId          String?
  enteredCommand  String
  mappedOperation String
  output          String
  executionTimeMs Int      @default(0)
  timestamp       DateTime @default(now())

  run  Run   @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([runId])
}

model Hint {
  id             String      @id @default(uuid())
  challengeId    String
  title          String
  content        String
  penaltySeconds Int         @default(30)
  pointPenalty   Int         @default(25)
  order          Int         @default(1)
  createdAt      DateTime    @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  usages    HintUsage[]

  @@index([challengeId])
}

model HintUsage {
  id           String   @id @default(uuid())
  runId        String
  hintId       String
  pointPenalty Int      @default(25)
  requestedAt  DateTime @default(now())

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  hint Hint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([runId, hintId])
  @@index([runId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?  // JSON string
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Authoritative teams are scoped to a competition; legacy Team remains historical.
model CompetitionTeam {
  id String @id @default(uuid())
  eventId String
  name String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members RosterMember[]
  runs Run[]
  @@unique([eventId, name])
  @@index([eventId])
}

model RosterMember {
  id String @id @default(uuid())
  eventId String
  teamId String
  email String
  position Int
  userId String?
  claimedAt DateTime?
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team CompetitionTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([eventId, email])
  @@unique([eventId, userId])
  @@unique([teamId, position])
  @@index([userId])
}
